# ============================================================
# Environment variables — copy to .env and fill in values
# NEVER commit .env to git
# ============================================================

# API key — clients must send this as X-API-Key header
AGENT_API_KEY=dev-key-change-me-in-production

# App
ENVIRONMENT=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Redis — set by docker-compose automatically; override for local dev
REDIS_URL=redis://localhost:6379/0

# Rate limiting
RATE_LIMIT_PER_MINUTE=10

# Monthly budget per user (USD)
MONTHLY_BUDGET_USD=10.0

# LLM (optional — leave blank to use mock)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
